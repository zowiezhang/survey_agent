# OpenAI Responses provider. Keep this file private if you copy it to .env.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.4

# Codex CLI provider. It uses your existing Codex login by default.
CODEX_COMMAND=codex
CODEX_MODEL=
# Optional: require a specific inherited environment variable before a Codex run.
# CODEX_TOKEN_ENV=MY_AGENT_TOKEN

# Required before exposing `research-harness serve` beyond localhost.
RESEARCH_HARNESS_API_TOKEN=
