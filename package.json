{
  "name": "research-harness",
  "version": "0.1.0",
  "description": "Evidence-first web research harness for OpenAI Responses, Codex CLI, and Claude Code agents.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "research-harness": "./dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "README.md",
    ".env.example"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "node --import tsx --test test/**/*.test.ts",
    "test:coverage": "c8 --all --reporter=text --reporter=lcov npm test",
    "check": "npm run build && npm test",
    "prepack": "npm run build"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "express": "^5.1.0",
    "jsonrepair": "^3.15.0",
    "openai": "^5.15.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.2",
    "c8": "^10.1.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
